{
  "name": "@aimk/image-spec",
  "version": "1.0.0",
  "description": "Shared image slot specifications for Angels in My Kitchen — single source of truth for upload dimensions, aspect ratios, cropping behaviour and safe areas",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc && node ./scripts/sync.js && node ./scripts/generate-docs.js",
    "sync": "node ./scripts/sync.js",
    "docs": "node ./scripts/generate-docs.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
